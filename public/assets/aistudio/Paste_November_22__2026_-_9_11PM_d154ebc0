<script>
  (function () {
    const bars = document.querySelectorAll('#weeklyBars rect');
    const readout = document.getElementById('chartSelectedReadout');

    bars.forEach((bar) => {
      bar.addEventListener('click', () => {
        bars.forEach((b) => {
          b.classList.remove('text-primary-container');
          b.classList.add('text-primary-fixed');
        });
        bar.classList.remove('text-primary-fixed');
        bar.classList.add('text-primary-container');
        if (readout) {
          readout.textContent = bar.dataset.day + ': ' + bar.dataset.score;
        }
      });
    });

    const playBtn = document.getElementById('playWaveformBtn');
    const playIcon = document.getElementById('playWaveformIcon');
    let isPlaying = false;

    if (playBtn && playIcon) {
      playBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        playIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
      });
    }

    const quickBtn = document.getElementById('quickPracticeBtn');
    if (quickBtn) {
      quickBtn.addEventListener('click', () => {
        quickBtn.classList.add('ring-0');
        const originalText = quickBtn.querySelector('span:last-child').textContent;
        quickBtn.querySelector('span:last-child').textContent = 'Preparando estudio...';
        setTimeout(() => {
          quickBtn.querySelector('span:last-child').textContent = originalText;
        }, 1200);
      });
    }
  })();
</script></main></div></body></html>